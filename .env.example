# Copy this file to `.env` and fill in your secrets. `.env` is gitignored.
#
# These environment variables override the matching `config.yaml` values, so API keys and
# passwords never have to be written to a tracked file. `docker compose` reads `.env`
# automatically for the variables it forwards to the server container.

# --- LLM (agents / companions) ---
# Full OpenAI-compatible chat-completions endpoint (the /chat/completions path is required).
# A bare base URL also works: the server appends /chat/completions when the URL has no path.
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# --- Database (optional; defaults live in config.yaml) ---
# DB_USER=root
# DB_PASS=testcosmic123
